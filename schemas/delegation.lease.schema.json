{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "2origin/delegation.lease.schema.json",
  "title": "delegation lease — 可撤销主体委托",
  "description": "主体授予一个逻辑影子在限定载体上使用限定能力的最小凭据。模型/载体可替换，权限不可凭空扩大。",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "kind", "id", "version", "scope", "principal", "grantee", "capabilities", "confirmation_required", "status", "issued_at", "expires_at"],
  "properties": {
    "spec": { "const": "2origin/delegation-lease/0.1" },
    "kind": { "const": "capability.delegation" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "scope": { "type": "string", "minLength": 1, "description": "例如 user:alice；不以人名猜测主体。" },
    "principal": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "grantee": {
      "type": "object", "additionalProperties": false, "required": ["shadow_id", "carrier_ids"],
      "properties": {
        "shadow_id": { "type": "string", "minLength": 1, "description": "逻辑代理身份；不是模型名称。" },
        "carrier_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "被此租约明确允许的承载实例。" }
      }
    },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "confirmation_required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "即使 capability 存在，也必须有独立本人确认的动作。" },
    "status": { "enum": ["active", "revoked"] },
    "issued_at": { "type": "string", "format": "date-time", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time", "minLength": 1 },
    "revocation": {
      "type": "object", "additionalProperties": false, "required": ["by", "reason", "effective_at"],
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "effective_at": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] }, "then": { "required": ["revocation"] } }
  ]
}
